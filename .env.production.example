# ============================================================
# Byakugan — variáveis de PRODUÇÃO (servidor Ferzion)
# Copie para .env NO SERVIDOR e preencha os segredos. NUNCA versione o .env.
# ============================================================

# --- Django ---
# Gere uma chave forte: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
ALLOWED_HOSTS=byakugan.ferzion.com.br
CSRF_TRUSTED_ORIGINS=https://byakugan.ferzion.com.br
# CORS normalmente vazio (SPA na mesma origem). Só preencha se o front vier de outro domínio.
CORS_ALLOWED_ORIGINS=

# --- PostgreSQL (rede interna do compose; NÃO exposto ao host) ---
POSTGRES_DB=byakugan
POSTGRES_USER=byakugan
# Defina uma senha forte:
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery (rede interna do compose; NÃO exposto ao host) ---
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Autenticação (JWT) ---
JWT_SECRET=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Motor de varredura ---
# Kill-switch global: a execução REAL de varredura só ocorre com este valor True.
# Mantenha False fora de um laboratório autorizado (ver docs/security.md).
# Sem esta variável, o padrão é False e todo scan falha de forma controlada
# ("Varredura desabilitada (BYAKUGAN_SCANNING_ENABLED=False)").
BYAKUGAN_SCANNING_ENABLED=False

# --- Vulnerability Assessment (NVD) ---
# Chave opcional (aumenta o rate limit do NVD de ~5 para ~50 req/30s):
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
NVD_REQUEST_DELAY_SECONDS=6.0
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# --- Motor de scan ofensivo: limites de execução ---
# Evita que um worker Celery fique preso indefinidamente num scan travado
# (perfil "aggressive"/"full" varre múltiplos hosts × múltiplos adapters).
# Aumente se scans grandes estourarem o tempo limite.
SCAN_TASK_TIME_LIMIT=1800
SCAN_TASK_SOFT_TIME_LIMIT=1700

# --- Assistente de IA (futuro) ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
