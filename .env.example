# ============================================================
# Byakugan — variáveis de ambiente (exemplo)
# Copie para .env e ajuste. NUNCA versione o .env com segredos reais.
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=byakugan
POSTGRES_USER=byakugan
POSTGRES_PASSWORD=byakugan
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Autenticação (JWT) ---
# Chave de assinatura dos tokens JWT — separada do DJANGO_SECRET_KEY de propósito
# (rotacionar uma não invalida a outra). Sem valor, cai no DJANGO_SECRET_KEY.
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Motor de varredura ---
# Kill-switch global: a execução REAL de varredura só ocorre com este valor True.
# Mantenha False fora de um laboratório autorizado (ver docs/security.md).
BYAKUGAN_SCANNING_ENABLED=False

# --- Vulnerability Assessment (NVD) ---
# Chave opcional (aumenta o rate limit do NVD de ~5 para ~50 req/30s):
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
NVD_REQUEST_DELAY_SECONDS=6.0
# Base da API NVD CVE 2.0 — normalmente não precisa mudar.
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# --- Motor de scan ofensivo: limites de execução ---
# scans.run_scan (Celery) pode varrer múltiplos hosts × múltiplos adapters
# (perfil "aggressive"/"full") — estes limites evitam que um worker fique
# preso indefinidamente num scan travado. SOFT dá chance de encerramento
# limpo antes do HARD matar a task. Aumente se scans grandes estourarem.
SCAN_TASK_TIME_LIMIT=1800
SCAN_TASK_SOFT_TIME_LIMIT=1700

# --- OpenSearch (futuro) ---
OPENSEARCH_HOST=
OPENSEARCH_PORT=9200

# --- Assistente de IA (futuro) ---
# Provedor recomendado: Anthropic (Claude). Também suporta outros via config.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Frontend (Vite) ---
# Prefixo VITE_ é obrigatório para expor ao browser.
VITE_API_BASE_URL=http://localhost:8000/api
